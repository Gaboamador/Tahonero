rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isCurrentGroupMember() {
      return isSignedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isFutureGroupMember() {
      return isSignedIn() && request.auth.uid in request.resource.data.memberIds;
    }

    function isGroupOwner() {
      return isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.membersMap[request.auth.uid].role == "owner"
        );
    }

    function groupImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function groupHasRequiredFields() {
      return request.resource.data.keys().hasAll([
        "name",
        "description",
        "createdBy",
        "createdAt",
        "updatedAt",
        "memberIds",
        "membersMap"
      ]);
    }

    function groupHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly([
        "entityType",
        "schemaVersion",
        "name",
        "description",
        "startDate",
        "endDate",
        "createdBy",
        "createdAt",
        "updatedAt",
        "memberIds",
        "participantIds",
        "accessUserIds",
        "membersMap"
      ]);
    }

    function groupOptionalTripFieldsAreValid() {
      return (
          !request.resource.data.keys().hasAny(["entityType"])
          || request.resource.data.entityType == "trip"
        )
        && (
          !request.resource.data.keys().hasAny(["schemaVersion"])
          || (
            request.resource.data.schemaVersion is int
            && request.resource.data.schemaVersion >= 2
          )
        )
        && (
          !request.resource.data.keys().hasAny(["participantIds"])
          || request.resource.data.participantIds is list
        )
        && (
          !request.resource.data.keys().hasAny(["accessUserIds"])
          || request.resource.data.accessUserIds is list
        )
        && (
          !request.resource.data.keys().hasAny(["startDate", "endDate"])
          || (
            request.resource.data.keys().hasAll(["startDate", "endDate"])
            && request.resource.data.startDate is string
            && request.resource.data.startDate.size() > 0
            && request.resource.data.endDate is string
            && request.resource.data.endDate.size() > 0
          )
        );
    }

    function groupBasicShapeIsValid() {
      return groupHasRequiredFields()
        && groupHasOnlyAllowedFields()
        && groupOptionalTripFieldsAreValid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.createdBy is string
        && request.resource.data.memberIds is list
        && request.resource.data.membersMap is map;
    }

    function groupCreateIsValid() {
      return groupBasicShapeIsValid()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && (
          !request.resource.data.keys().hasAny(["participantIds"])
          || request.auth.uid in request.resource.data.participantIds
        )
        && (
          !request.resource.data.keys().hasAny(["accessUserIds"])
          || request.auth.uid in request.resource.data.accessUserIds
        )
        && request.resource.data.membersMap[request.auth.uid].uid == request.auth.uid
        && (
          !request.resource.data.membersMap[request.auth.uid].keys().hasAny(["memberId"])
          || request.resource.data.membersMap[request.auth.uid].memberId == request.auth.uid
        )
        && (
          !request.resource.data.membersMap[request.auth.uid].keys().hasAny(["userUid"])
          || request.resource.data.membersMap[request.auth.uid].userUid == request.auth.uid
        )
        && request.resource.data.membersMap[request.auth.uid].role == "owner"
        && request.resource.data.membersMap[request.auth.uid].type == "user";
    }

    function groupUpdateIsValid() {
      return groupBasicShapeIsValid()
        && groupImmutableFieldsAreUnchanged()
        && isCurrentGroupMember()
        && isFutureGroupMember();
    }

    function userProfileHasValidShape() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "displayName",
        "email",
        "photoURL",
        "createdAt",
        "updatedAt"
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email is string
      && request.resource.data.displayName is string
      && request.resource.data.photoURL is string;
    }

    function userLookupHasValidShape(email) {
      return request.resource.data.keys().hasOnly([
        "uid",
        "displayName",
        "email",
        "photoURL",
        "updatedAt"
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == email
      && request.resource.data.email is string
      && request.resource.data.displayName is string
      && request.resource.data.photoURL is string;
    }

    function movementHasBaseFields() {
      return request.resource.data.keys().hasAll([
        "transactionType",
        "description",
        "totalAmountCents",
        "currency",
        "createdBy",
        "createdAt",
        "updatedAt"
      ])
      && request.resource.data.description is string
      && request.resource.data.description.size() > 0
      && request.resource.data.totalAmountCents is number
      && request.resource.data.totalAmountCents > 0
      && request.resource.data.currency == "ARS"
      && request.resource.data.createdBy is string;
    }

    function movementImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidExpense() {
      return movementHasBaseFields()
        && request.resource.data.transactionType == "expense"
        && request.resource.data.keys().hasOnly([
          "transactionType",
          "description",
          "totalAmountCents",
          "currency",
          "paidBy",
          "paidByName",
          "splitType",
          "participantIds",
          "sharesMap",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.paidBy is string
        && request.resource.data.paidByName is string
        && request.resource.data.splitType == "equal"
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() > 0
        && request.resource.data.sharesMap is map;
    }

    function isValidPayment() {
      return movementHasBaseFields()
        && request.resource.data.transactionType == "payment"
        && request.resource.data.keys().hasOnly([
          "transactionType",
          "description",
          "totalAmountCents",
          "currency",
          "fromId",
          "fromName",
          "toId",
          "toName",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.fromId is string
        && request.resource.data.fromName is string
        && request.resource.data.toId is string
        && request.resource.data.toName is string
        && request.resource.data.fromId != request.resource.data.toId;
    }

    function movementCreateIsValid() {
      return request.resource.data.createdBy == request.auth.uid
        && (isValidExpense() || isValidPayment());
    }

    function movementUpdateIsValid() {
      return movementImmutableFieldsAreUnchanged()
        && (isValidExpense() || isValidPayment());
    }

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create, update: if isSelf(userId)
        && userProfileHasValidShape();

      allow delete: if false;
    }

    match /userLookup/{email} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && userLookupHasValidShape(email);

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && groupCreateIsValid();

      allow read: if isCurrentGroupMember();

      allow update: if groupUpdateIsValid();

      allow delete: if isGroupOwner();

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && movementCreateIsValid();

        allow update: if isGroupMember(groupId)
          && movementUpdateIsValid();

        allow delete: if isGroupMember(groupId);
      }
    }
  }
}
