rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isCurrentGroupMember() {
      return isSignedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isFutureGroupMember() {
      return isSignedIn() && request.auth.uid in request.resource.data.memberIds;
    }

    function isGroupOwner() {
      return isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.membersMap[request.auth.uid].role == "owner"
        );
    }

    function groupImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function groupHasRequiredFields() {
      return request.resource.data.keys().hasAll([
        "name",
        "description",
        "createdBy",
        "createdAt",
        "updatedAt",
        "memberIds",
        "membersMap"
      ]);
    }

    function groupHasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly([
        "entityType",
        "schemaVersion",
        "name",
        "description",
        "startDate",
        "endDate",
        "firstMeal",
        "lastMeal",
        "createdBy",
        "createdAt",
        "updatedAt",
        "memberIds",
        "participantIds",
        "accessUserIds",
        "membersMap"
      ]);
    }

    function isMealBoundary(value) {
      return value == "lunch" || value == "dinner";
    }

    function groupOptionalTripFieldsAreValid() {
      return (
          !request.resource.data.keys().hasAny(["entityType"])
          || request.resource.data.entityType == "trip"
        )
        && (
          !request.resource.data.keys().hasAny(["schemaVersion"])
          || (
            request.resource.data.schemaVersion is int
            && request.resource.data.schemaVersion >= 2
          )
        )
        && (
          !request.resource.data.keys().hasAny(["participantIds"])
          || request.resource.data.participantIds is list
        )
        && (
          !request.resource.data.keys().hasAny(["accessUserIds"])
          || request.resource.data.accessUserIds is list
        )
        && (
          !request.resource.data.keys().hasAny(["startDate", "endDate"])
          || (
            request.resource.data.keys().hasAll(["startDate", "endDate"])
            && request.resource.data.startDate is string
            && request.resource.data.startDate.size() > 0
            && request.resource.data.endDate is string
            && request.resource.data.endDate.size() > 0
          )
        )
        && (
          !request.resource.data.keys().hasAny(["firstMeal", "lastMeal"])
          || (
            request.resource.data.keys().hasAll(["firstMeal", "lastMeal"])
            && isMealBoundary(request.resource.data.firstMeal)
            && isMealBoundary(request.resource.data.lastMeal)
            && (
              request.resource.data.startDate != request.resource.data.endDate
              || request.resource.data.firstMeal != "dinner"
              || request.resource.data.lastMeal != "lunch"
            )
          )
        );
    }

    function groupBasicShapeIsValid() {
      return groupHasRequiredFields()
        && groupHasOnlyAllowedFields()
        && groupOptionalTripFieldsAreValid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.createdBy is string
        && request.resource.data.memberIds is list
        && request.resource.data.membersMap is map;
    }

    function groupCreateIsValid() {
      return groupBasicShapeIsValid()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && (
          !request.resource.data.keys().hasAny(["participantIds"])
          || request.auth.uid in request.resource.data.participantIds
        )
        && (
          !request.resource.data.keys().hasAny(["accessUserIds"])
          || request.auth.uid in request.resource.data.accessUserIds
        )
        && request.resource.data.membersMap[request.auth.uid].uid == request.auth.uid
        && (
          !request.resource.data.membersMap[request.auth.uid].keys().hasAny(["memberId"])
          || request.resource.data.membersMap[request.auth.uid].memberId == request.auth.uid
        )
        && (
          !request.resource.data.membersMap[request.auth.uid].keys().hasAny(["userUid"])
          || request.resource.data.membersMap[request.auth.uid].userUid == request.auth.uid
        )
        && request.resource.data.membersMap[request.auth.uid].role == "owner"
        && request.resource.data.membersMap[request.auth.uid].type == "user";
    }

    function groupUpdateIsValid() {
      return groupBasicShapeIsValid()
        && groupImmutableFieldsAreUnchanged()
        && isCurrentGroupMember()
        && isFutureGroupMember();
    }

    function userProfileHasValidShape() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "displayName",
        "email",
        "photoURL",
        "createdAt",
        "updatedAt"
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email is string
      && request.resource.data.displayName is string
      && request.resource.data.photoURL is string;
    }

    function userLookupHasValidShape(email) {
      return request.resource.data.keys().hasOnly([
        "uid",
        "displayName",
        "email",
        "photoURL",
        "updatedAt"
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == email
      && request.resource.data.email is string
      && request.resource.data.displayName is string
      && request.resource.data.photoURL is string;
    }

    function movementHasBaseFields() {
      return request.resource.data.keys().hasAll([
        "transactionType",
        "description",
        "totalAmountCents",
        "currency",
        "createdBy",
        "createdAt",
        "updatedAt"
      ])
      && request.resource.data.description is string
      && request.resource.data.description.size() > 0
      && request.resource.data.totalAmountCents is number
      && request.resource.data.totalAmountCents > 0
      && request.resource.data.currency == "ARS"
      && request.resource.data.createdBy is string;
    }

    function movementImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidExpense() {
      return movementHasBaseFields()
        && request.resource.data.transactionType == "expense"
        && request.resource.data.keys().hasOnly([
          "transactionType",
          "description",
          "totalAmountCents",
          "currency",
          "paidBy",
          "paidByName",
          "splitType",
          "participantIds",
          "sharesMap",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.paidBy is string
        && request.resource.data.paidByName is string
        && request.resource.data.splitType == "equal"
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() > 0
        && request.resource.data.sharesMap is map;
    }

    function isValidPayment() {
      return movementHasBaseFields()
        && request.resource.data.transactionType == "payment"
        && request.resource.data.keys().hasOnly([
          "transactionType",
          "description",
          "totalAmountCents",
          "currency",
          "fromId",
          "fromName",
          "toId",
          "toName",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.fromId is string
        && request.resource.data.fromName is string
        && request.resource.data.toId is string
        && request.resource.data.toName is string
        && request.resource.data.fromId != request.resource.data.toId;
    }

    function movementCreateIsValid() {
      return request.resource.data.createdBy == request.auth.uid
        && (isValidExpense() || isValidPayment());
    }

    function movementUpdateIsValid() {
      return movementImmutableFieldsAreUnchanged()
        && (isValidExpense() || isValidPayment());
    }

    function isAllowedFoodUnit(unit) {
      return unit in ["g", "kg", "ml", "l", "unidad", "paquete", "lata", "botella"];
    }

    function foodItemImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidMeal() {
      return request.resource.data.keys().hasOnly([
          "name",
          "servings",
          "ingredients",
          "sourceRecipeId",
          "sourceRecipeOwnerUid",
          "sourceRecipeScope",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "servings",
          "ingredients",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.servings is int
        && request.resource.data.servings > 0
        && request.resource.data.ingredients is list
        && (
          !request.resource.data.keys().hasAny(["sourceRecipeId", "sourceRecipeOwnerUid"])
          || (
            request.resource.data.keys().hasAll(["sourceRecipeId", "sourceRecipeOwnerUid"])
            && request.resource.data.sourceRecipeId is string
            && request.resource.data.sourceRecipeId.size() > 0
            && request.resource.data.sourceRecipeOwnerUid is string
            && request.resource.data.sourceRecipeOwnerUid.size() > 0
            && (
              !request.resource.data.keys().hasAny(["sourceRecipeScope"])
              || request.resource.data.sourceRecipeScope == "shared"
            )
          )
        )
        && request.resource.data.createdBy is string;
    }

    function isValidMealPlan(slotId) {
      return request.resource.data.keys().hasOnly([
          "date",
          "mealType",
          "assignmentType",
          "mealId",
          "label",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "date",
          "mealType",
          "assignmentType",
          "mealId",
          "label",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && isMealBoundary(request.resource.data.mealType)
        && slotId == request.resource.data.date + "_" + request.resource.data.mealType
        && request.resource.data.assignmentType in ["meal", "leftovers", "custom"]
        && request.resource.data.mealId is string
        && request.resource.data.label is string
        && request.resource.data.createdBy is string
        && (
          (request.resource.data.assignmentType == "meal"
            && request.resource.data.mealId.size() > 0
            && request.resource.data.label == "")
          || (request.resource.data.assignmentType == "leftovers"
            && request.resource.data.mealId == ""
            && request.resource.data.label == "Sobras")
          || (request.resource.data.assignmentType == "custom"
            && request.resource.data.mealId == ""
            && request.resource.data.label.size() > 0)
        );
    }

    function isValidFoodExtra() {
      return request.resource.data.keys().hasOnly([
          "name",
          "mode",
          "quantity",
          "unit",
          "purchasePlace",
          "ingredients",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "mode",
          "quantity",
          "unit",
          "ingredients",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.mode in ["direct", "recipe"]
        && request.resource.data.quantity is number
        && request.resource.data.unit is string
        && (
          !request.resource.data.keys().hasAny(["purchasePlace"])
          || request.resource.data.purchasePlace is string
        )
        && request.resource.data.ingredients is list
        && request.resource.data.createdBy is string
        && (
          (request.resource.data.mode == "direct"
            && request.resource.data.quantity > 0
            && isAllowedFoodUnit(request.resource.data.unit)
            && request.resource.data.ingredients.size() == 0)
          || (request.resource.data.mode == "recipe"
            && request.resource.data.quantity == 0
            && request.resource.data.unit == "")
        );
    }

    function isValidDrinkPlan() {
      return request.resource.data.keys().hasOnly([
          "name",
          "calculationMode",
          "quantity",
          "unit",
          "purchasePlace",
          "participantIds",
          "coverageMode",
          "coverageDays",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "calculationMode",
          "quantity",
          "unit",
          "participantIds",
          "coverageMode",
          "coverageDays",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.calculationMode in ["fixed", "perPersonPerDay"]
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && isAllowedFoodUnit(request.resource.data.unit)
        && (
          !request.resource.data.keys().hasAny(["purchasePlace"])
          || request.resource.data.purchasePlace is string
        )
        && request.resource.data.participantIds is list
        && request.resource.data.coverageMode in ["trip", "custom"]
        && request.resource.data.coverageDays is int
        && request.resource.data.coverageDays >= 0
        && request.resource.data.createdBy is string
        && (
          (request.resource.data.calculationMode == "fixed"
            && request.resource.data.participantIds.size() == 0
            && request.resource.data.coverageMode == "trip"
            && request.resource.data.coverageDays == 0)
          || (request.resource.data.calculationMode == "perPersonPerDay"
            && request.resource.data.participantIds.size() > 0
            && (
              (request.resource.data.coverageMode == "trip"
                && request.resource.data.coverageDays == 0)
              || (request.resource.data.coverageMode == "custom"
                && request.resource.data.coverageDays > 0)
            ))
        );
    }

    function isTripOwnerById(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function canManageEmpanadaOrder(groupId, memberId) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return isSignedIn()
        && request.auth.uid in groupData.memberIds
        && groupData.membersMap.keys().hasAny([memberId])
        && (
          groupData.membersMap[memberId].uid == request.auth.uid
          || (
            groupData.membersMap[memberId].keys().hasAny(["userUid"])
            && groupData.membersMap[memberId].userUid == request.auth.uid
          )
          || (
            groupData.createdBy == request.auth.uid
            && groupData.membersMap[memberId].type == "manual"
          )
        );
    }

    function isValidEmpanadaVendor() {
      return request.resource.data.keys().hasOnly([
          "name",
          "flavors",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "flavors",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.flavors is list
        && request.resource.data.flavors.size() > 0
        && request.resource.data.createdBy is string;
    }

    function sharedLibraryImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function sharedAccessIsValid() {
      return request.resource.data.accessUserIds is list
        && request.resource.data.accessUserIds.size() > 0
        && request.auth.uid in request.resource.data.accessUserIds;
    }

    function sharedAccessOnlyExpands() {
      return request.resource.data.accessUserIds.hasAll(resource.data.accessUserIds);
    }

    function isValidSharedRecipe() {
      return request.resource.data.keys().hasOnly([
          "name",
          "servings",
          "ingredients",
          "createdBy",
          "accessUserIds",
          "legacyOwnerUid",
          "legacyRecipeId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "servings",
          "ingredients",
          "createdBy",
          "accessUserIds",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.servings is int
        && request.resource.data.servings > 0
        && request.resource.data.ingredients is list
        && request.resource.data.createdBy is string
        && request.resource.data.accessUserIds is list
        && request.resource.data.accessUserIds.size() > 0
        && (
          !request.resource.data.keys().hasAny(["legacyOwnerUid", "legacyRecipeId"])
          || (
            request.resource.data.keys().hasAll(["legacyOwnerUid", "legacyRecipeId"])
            && request.resource.data.legacyOwnerUid is string
            && request.resource.data.legacyOwnerUid.size() > 0
            && request.resource.data.legacyRecipeId is string
            && request.resource.data.legacyRecipeId.size() > 0
          )
        );
    }

    function isValidSharedEmpanadaVendor() {
      return request.resource.data.keys().hasOnly([
          "name",
          "flavors",
          "createdBy",
          "accessUserIds",
          "legacyOwnerUid",
          "legacyVendorId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "flavors",
          "createdBy",
          "accessUserIds",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.flavors is list
        && request.resource.data.flavors.size() > 0
        && request.resource.data.createdBy is string
        && request.resource.data.accessUserIds is list
        && request.resource.data.accessUserIds.size() > 0
        && (
          !request.resource.data.keys().hasAny(["legacyOwnerUid", "legacyVendorId"])
          || (
            request.resource.data.keys().hasAll(["legacyOwnerUid", "legacyVendorId"])
            && request.resource.data.legacyOwnerUid is string
            && request.resource.data.legacyOwnerUid.size() > 0
            && request.resource.data.legacyVendorId is string
            && request.resource.data.legacyVendorId.size() > 0
          )
        );
    }

    function isValidEmpanadaConfig() {
      return request.resource.data.keys().hasOnly([
          "vendorName",
          "sourceVendorId",
          "sourceVendorOwnerUid",
          "sourceVendorScope",
          "flavors",
          "mealSlotIds",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "vendorName",
          "sourceVendorId",
          "sourceVendorOwnerUid",
          "flavors",
          "mealSlotIds",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.vendorName is string
        && request.resource.data.vendorName.size() > 0
        && request.resource.data.sourceVendorId is string
        && request.resource.data.sourceVendorId.size() > 0
        && request.resource.data.sourceVendorOwnerUid is string
        && (
          !request.resource.data.keys().hasAny(["sourceVendorScope"])
          || request.resource.data.sourceVendorScope == "shared"
        )
        && request.resource.data.flavors is list
        && request.resource.data.flavors.size() > 0
        && request.resource.data.mealSlotIds is list
        && request.resource.data.createdBy is string;
    }

    function isValidEmpanadaOrder(memberId) {
      return request.resource.data.keys().hasOnly([
          "memberId",
          "items",
          "allocations",
          "consumed",
          "isFinalized",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "memberId",
          "items",
          "allocations",
          "consumed",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt"
        ])
        && request.resource.data.memberId == memberId
        && request.resource.data.items is map
        && request.resource.data.allocations is map
        && request.resource.data.consumed is map
        && (
          !request.resource.data.keys().hasAny(["isFinalized"])
          || request.resource.data.isFinalized is bool
        )
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function empanadaImmutableFieldsAreUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.accessUserIds;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && sharedAccessIsValid()
        && isValidSharedRecipe();

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.accessUserIds
        && sharedLibraryImmutableFieldsAreUnchanged()
        && sharedAccessIsValid()
        && sharedAccessOnlyExpands()
        && isValidSharedRecipe();

      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.accessUserIds.size() == 1
        && request.auth.uid in resource.data.accessUserIds;
    }

    match /empanadaVendors/{vendorId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.accessUserIds;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && sharedAccessIsValid()
        && isValidSharedEmpanadaVendor();

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.accessUserIds
        && sharedLibraryImmutableFieldsAreUnchanged()
        && sharedAccessIsValid()
        && sharedAccessOnlyExpands()
        && isValidSharedEmpanadaVendor();

      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.accessUserIds.size() == 1
        && request.auth.uid in resource.data.accessUserIds;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create, update: if isSelf(userId)
        && userProfileHasValidShape();

      allow delete: if false;

      match /empanadaVendors/{vendorId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidEmpanadaVendor();
        allow update: if isSelf(userId)
          && empanadaImmutableFieldsAreUnchanged()
          && isValidEmpanadaVendor();
        allow delete: if isSelf(userId);
      }

      match /recipes/{recipeId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidMeal();
        allow update: if isSelf(userId)
          && foodItemImmutableFieldsAreUnchanged()
          && isValidMeal();
        allow delete: if isSelf(userId);
      }
    }

    match /userLookup/{email} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && userLookupHasValidShape(email);

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if isSignedIn()
        && groupCreateIsValid();

      allow read: if isCurrentGroupMember();

      allow update: if groupUpdateIsValid();

      allow delete: if isGroupOwner();

      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && movementCreateIsValid();

        allow update: if isGroupMember(groupId)
          && movementUpdateIsValid();

        allow delete: if isGroupMember(groupId);
      }

      match /meals/{mealId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidMeal();
        allow update: if isGroupMember(groupId)
          && foodItemImmutableFieldsAreUnchanged()
          && isValidMeal();
        allow delete: if isGroupMember(groupId);
      }

      match /mealPlan/{slotId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidMealPlan(slotId);
        allow update: if isGroupMember(groupId)
          && foodItemImmutableFieldsAreUnchanged()
          && isValidMealPlan(slotId);
        allow delete: if isGroupMember(groupId);
      }

      match /foodExtras/{extraId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidFoodExtra();
        allow update: if isGroupMember(groupId)
          && foodItemImmutableFieldsAreUnchanged()
          && isValidFoodExtra();
        allow delete: if isGroupMember(groupId);
      }

      match /drinkPlans/{drinkId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidDrinkPlan();
        allow update: if isGroupMember(groupId)
          && foodItemImmutableFieldsAreUnchanged()
          && isValidDrinkPlan();
        allow delete: if isGroupMember(groupId);
      }

      match /empanadaConfig/{configId} {
        allow read: if isGroupMember(groupId);
        allow create: if configId == "main"
          && isTripOwnerById(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidEmpanadaConfig();
        allow update: if configId == "main"
          && isTripOwnerById(groupId)
          && empanadaImmutableFieldsAreUnchanged()
          && isValidEmpanadaConfig();
        allow delete: if configId == "main" && isTripOwnerById(groupId);
      }

      match /empanadaOrders/{memberId} {
        allow read: if isGroupMember(groupId);
        allow create: if canManageEmpanadaOrder(groupId, memberId)
          && request.resource.data.createdBy == request.auth.uid
          && isValidEmpanadaOrder(memberId);
        allow update: if canManageEmpanadaOrder(groupId, memberId)
          && empanadaImmutableFieldsAreUnchanged()
          && isValidEmpanadaOrder(memberId);
        allow delete: if canManageEmpanadaOrder(groupId, memberId);
      }

      match /shoppingState/{itemKey} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            "checked",
            "signature",
            "updatedBy",
            "updatedAt"
          ])
          && request.resource.data.checked == true
          && request.resource.data.signature is string
          && request.resource.data.signature.size() > 0
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isGroupMember(groupId);
      }
    }
  }
}
